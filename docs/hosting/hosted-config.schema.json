{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapping.a13.info/schemas/apheliondmm-hosted-config-v1.json",
  "title": "AphelionDMM hosted collaboration configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["bind_address", "public_origin", "trusted_proxy_cidrs", "database", "limits", "telemetry"],
  "properties": {
    "bind_address": { "type": "string", "minLength": 1, "maxLength": 255 },
    "public_origin": { "$ref": "#/$defs/httpsOrigin" },
    "trusted_proxy_cidrs": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 3, "maxLength": 64 }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dsn"],
      "properties": { "dsn": { "$ref": "#/$defs/secretSource" } }
    },
    "auth_provider": {
      "type": "string",
      "enum": ["oidc", "discord"],
      "default": "oidc",
      "description": "Omitted values retain OIDC compatibility. Only the selected provider is initialized."
    },
    "oidc": { "type": "object" },
    "discord": { "type": "object" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_connections", "max_operation_changes", "max_websocket_message_bytes", "max_http_body_bytes", "max_snapshot_body_bytes"],
      "properties": {
        "max_connections": { "type": "integer", "minimum": 1 },
        "max_operation_changes": { "type": "integer", "minimum": 1, "maximum": 4096, "description": "Legacy JSON session limit; negotiated bulk sessions use byte admission instead." },
        "bulk_spool_bytes": { "type": "integer", "minimum": 0, "description": "Shared bulk transaction spool budget in bytes. Zero selects the 512 MiB default." },
        "bulk_working_bytes": { "type": "integer", "minimum": 0, "description": "Shared bulk transaction working-memory admission budget in bytes. Zero selects the 2 GiB default." },
        "max_websocket_message_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "max_http_body_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "max_snapshot_body_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": {
          "oneOf": [
            { "const": "" },
            { "$ref": "#/$defs/httpsOrigin" }
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": { "auth_provider": { "const": "oidc" }, "oidc": { "$ref": "#/$defs/oidc" } },
      "required": ["auth_provider", "oidc"]
    },
    {
      "properties": { "auth_provider": { "const": "discord" }, "discord": { "$ref": "#/$defs/discord" } },
      "required": ["auth_provider", "discord"]
    },
    {
      "not": { "required": ["auth_provider"] },
      "properties": { "oidc": { "$ref": "#/$defs/oidc" } },
      "required": ["oidc"]
    }
  ],
  "$defs": {
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "client_id", "redirect_url", "client_secret"],
      "properties": {
        "issuer": { "$ref": "#/$defs/httpsIssuer" },
        "client_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "redirect_url": { "type": "string", "format": "uri", "pattern": "^https://[^?#]+/v1/auth/complete$" },
        "client_secret": { "$ref": "#/$defs/secretSource" }
      }
    },
    "discord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "guild_id", "redirect_url", "client_secret"],
      "properties": {
        "client_id": { "type": "string", "pattern": "^[0-9]{1,20}$" },
        "guild_id": { "type": "string", "pattern": "^[0-9]{1,20}$" },
        "redirect_url": { "type": "string", "format": "uri", "pattern": "^https://[^?#]+/v1/auth/complete$" },
        "client_secret": { "$ref": "#/$defs/secretSource" },
        "session_ttl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "default": "12h",
          "description": "Go duration greater than zero and at most 24h; omitted values default to 12h."
        }
      }
    },

    "httpsIssuer": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
    },
    "httpsOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+/?$"
    },
    "secretSource": {
      "type": "object",
      "unevaluatedProperties": false,
      "oneOf": [
        {
          "required": ["environment"],
          "properties": {
            "environment": { "type": "string", "pattern": "^APHELIONDMM_[A-Z0-9_]+$" }
          }
        },
        {
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\]).+" }
          }
        }
      ]
    }
  }
}
